meta {
  name: Recompute Attendance
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/hr/attendance/recompute
  body: json
  auth: none
}

headers {
  Cookie: auth_token={{authToken}}
}

body:json {
  {
    "from": "2026-07-01",
    "to": "2026-07-28"
  }
}

docs {
  Re-resolves days that were ALREADY marked, applying the current shift rules —
  the nightly job only fills days with no row yet, so this is the only way a
  newly-assigned shift reaches days the employee has already punched. Approved
  regularizations are never overwritten.

  Omit user_id to recompute every employee in the caller's branch; pass it to
  limit the run to one. Needs hr.attendance.admin.assignments.manage.

  Returns { employees_processed, days_processed, statuses }.
}
