# ─────────────────────────────────────────────────────────────────────────────
# HRMS product (msq-hrms) — hr-service, hr-web.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL connection (shared cluster — see msq-core) ──────────────────
DB_NAME=crm
DB_HOST=localhost
DB_PORT=5432
DB_CONTAINER_NAME=crm-db-server

# Per-product DB login role (P1.2/D8, created by db_scripts/19). Reads/writes
# only hr + read-only iam/entity/geo.
DB_HR_SVC_USER=hr_svc
DB_HR_SVC_PASSWORD=HrSvc_Dev2025
DB_SERVICE_USER=root_service
DB_SERVICE_PASSWORD=CrmSvc_Dev2025

DATABASE_URL=postgres://hr_svc:HrSvc_Dev2025@localhost:5432/crm
DATABASE_URL_SERVICE=postgres://root_service:CrmSvc_Dev2025@localhost:5432/crm
DB_PRODUCT_SCOPED_LOGIN=true

PG_MAX=10
PG_IDLE_TIMEOUT=30
PG_SSL_MODE=disable

# ── Auth (must match msq-core's identity-service exactly) ─────────────────
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars
# JWT_PUBLIC_KEY=    # RS256 verification — preferred over JWT_SECRET
INTERNAL_SERVICE_SECRET=change-me-to-another-long-random-string

# ─────────────────────────────────────────────────────────────────────────────
# Attendance photo storage. Punch selfies arrive as base64 (≤2 MB), written via
# a PhotoStorage driver, re-served only through GET /hr/attendance/photos/:id.
# ─────────────────────────────────────────────────────────────────────────────
PHOTO_STORAGE_DRIVER=local
PHOTO_STORAGE_DIR=/data/attendance-photos
PHOTO_MAX_BYTES=2097152

# ─────────────────────────────────────────────────────────────────────────────
# Face verification (self-hosted CompreFace, internal-only). NEVER exposed
# publicly or proxied by the gateway. require_face_match is an opt-in per-org
# rule; when off, the API key may stay blank. See docs/FACE_VERIFICATION.md
# (msq-core) for the one-time setup.
# ─────────────────────────────────────────────────────────────────────────────
FACE_DRIVER=compreface
COMPREFACE_URL=http://localhost:8010
COMPREFACE_API_KEY=
FACE_VERIFY_TIMEOUT_MS=5000

COMPREFACE_POSTGRES_USER=compreface
COMPREFACE_POSTGRES_PASSWORD=change-me-compreface-db
COMPREFACE_POSTGRES_DB=compreface
COMPREFACE_ADMIN_UI_PORT=8010

# ─────────────────────────────────────────────────────────────────────────────
# Service ports
# ─────────────────────────────────────────────────────────────────────────────
HR_SERVICE_PORT=4007

# ── Internal service URLs (this repo's service + the shared gateway) ────────
API_GATEWAY_INTERNAL_URL=http://localhost:4000
HR_SERVICE_URL=http://localhost:4007

NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# hr-web (Next.js) → hr.app.com
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_LMS_URL=http://localhost:3001
NEXT_PUBLIC_HR_URL=http://localhost:3002
NEXT_PUBLIC_TASK_URL=http://localhost:3003
NEXT_PUBLIC_PASSWORD_MIN_LENGTH=12
COOKIE_SECURE=false
